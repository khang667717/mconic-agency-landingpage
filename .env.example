# ===================== MCONIC ENVIRONMENT VARIABLES =====================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git - use .env.example as template

# ============ BACKEND CONFIGURATION ============
NODE_ENV=development
PORT=3000

# ============ DATABASE ============
# Local SQLite database path (read-only on Vercel)
DATABASE_PATH=./leads.db

# ============ EMAIL CONFIGURATION (Gmail SMTP) ============
# Prerequisites:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# 3. Copy the generated 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_SECURE=false

# Admin email to receive lead notifications
ADMIN_EMAIL=admin@mconic.vn

# Email sender display name
SENDER_NAME=MCONIC Event Agency

# ============ GOOGLE SHEETS INTEGRATION ============
# Setup Google Sheets API:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project
# 3. Enable Google Sheets API
# 4. Create a service account and download credentials JSON
# 5. Share your spreadsheet with the service account email
# 6. Get the Spreadsheet ID from the URL: docs.google.com/spreadsheets/d/{ID}/

GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB_NAME=Leads

# Service account credentials as JSON string
# For Vercel: Copy the entire JSON and paste as one-line string
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ============ SECURITY & API RATE LIMITING ============
# Admin token for accessing /api/admin/leads endpoint
ADMIN_TOKEN=your-secret-admin-token

# Rate limiter: requests per window (default: 5 per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# ============ FRONTEND CONFIGURATION ============
VITE_BASE_URL=http://localhost:3000

# ============ VERCEL DEPLOYMENT ============
# These are auto-set by Vercel platform - do not modify manually
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=mconic.vercel.app

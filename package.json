{
  "name": "mconic-backend",
  "version": "1.0.0",
  "description": "Professional backend for MCONIC Redesign landing page",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "concurrently \"npm run build:watch\" \"npm run server:dev\"",
    "dev:server": "node --watch api/server.js",
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest tests/unit --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "googleapis": "^144.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/jest": "^29.5.14",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "MCONIC",
  "license": "ISC"
}

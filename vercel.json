{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/)(?!images/)(?!css/)(?!js/)(?!assets/)(?!\\..*).*)$",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/server.js": {
      "includeFiles": "assets/documents/**"
    }
  },
  "headers": [
    {
      "source": "/(.*\\.(css|js|png|jpg|jpeg|webp|svg|ico|pdf))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
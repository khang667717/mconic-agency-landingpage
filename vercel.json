{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/((?!api/)(?!images/)(?!css/)(?!js/)(?!assets/)(?!\\..*).*)$",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/server.js": {
      "includeFiles": "assets/documents/**"
    }
  },
  "headers": [
    {
      "source": "/(.*\\.(css|js|png|jpg|jpeg|webp|svg|ico|pdf))$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
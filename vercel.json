{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "public": true,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    }
  ],
  "functions": {
    "api/server.js": {
      "includeFiles": "assets/documents/**"
    }
  }
}
